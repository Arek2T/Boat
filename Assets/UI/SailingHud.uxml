<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement enabled="true" name="Hud-Main" style="flex-grow: 1; position: absolute; left: -140px; bottom: -20px; flex-direction: row; align-items: flex-end; justify-content: center; align-self: flex-end; scale: 0.8 0.8;">
        <ui:VisualElement name="SailOpening" style="flex-grow: 1; align-self: auto; align-items: stretch;">
            <ui:VisualElement name="sail-visual-area" enabled="true" style="flex-grow: 1; scale: 0.5 0.6; translate: 0 49px;">
                <ui:Image source="project://database/Assets/UI/beam.png?fileID=2800000&amp;guid=c2a16177ae749c54e9c3f3987267d88f&amp;type=3#beam" name="mid-beam" style="opacity: 1; visibility: visible; display: flex; overflow: visible; width: 469px; height: 121px; top: 136px; aspect-ratio: auto; scale: 0.5 1.5; translate: 0 77px; align-self: auto; flex-direction: column; rotate: 90deg;"/>
                <ui:Image source="project://database/Assets/UI/beam.png?fileID=2800000&amp;guid=c2a16177ae749c54e9c3f3987267d88f&amp;type=3#beam" name="top-beam" style="opacity: 1; visibility: visible; display: flex; overflow: visible; width: 469px; height: 121px; top: 136px; aspect-ratio: auto; scale: 0.7 1.5; translate: 0 -180px;"/>
                <ui:Image source="project://database/Assets/UI/flag.png?fileID=2800000&amp;guid=488d4f735aa7bed40a4573accecf49e7&amp;type=3#flag" name="sail-image" style="opacity: 1; visibility: visible; display: flex; overflow: visible; width: 266px; height: 81%; top: auto; aspect-ratio: auto; scale: 1 1 40; translate: 176px 58px; bottom: 9px; position: absolute; transform-origin: bottom; left: -73px;"/>
                <ui:Image source="project://database/Assets/UI/beam.png?fileID=2800000&amp;guid=c2a16177ae749c54e9c3f3987267d88f&amp;type=3#beam" name="bottom-beam" style="opacity: 1; visibility: visible; display: flex; overflow: visible; width: 469px; height: 121px; top: 136px; aspect-ratio: auto; scale: 0.7 1.5; translate: 0 -35px;"/>
            </ui:VisualElement>
            <ui:Label text="Sail Opening: 0%" name="sail-opening-label" style="font-size: 40px; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/PirataOne-Regular.ttf?fileID=12800000&amp;guid=16f25ff010d8e574fbe3ec65d8403acb&amp;type=3#PirataOne-Regular&quot;); letter-spacing: 2px; -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; left: 110px; color: rgb(255, 255, 255); top: 4px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SailRotation" style="flex-grow: 1; align-self: auto; align-items: stretch; left: -50px; margin-top: 0; margin-left: 0; margin-right: 0; margin-bottom: 0; top: 5px;">
            <ui:Image source="project://database/Assets/UI/plank.png?fileID=2800000&amp;guid=299978c49da158e47bfbec646c7e23aa&amp;type=3#plank" name="rotation-plank-top" style="opacity: 1; visibility: visible; display: flex; overflow: visible; width: 229px; height: 85px; top: 0; aspect-ratio: auto; scale: 0.8 1.1; translate: 0 0; align-self: auto; flex-direction: column; rotate: 0; transform-origin: top;"/>
            <ui:Image source="project://database/Assets/UI/plank.png?fileID=2800000&amp;guid=299978c49da158e47bfbec646c7e23aa&amp;type=3#plank" name="rotation-plank-bottom" style="opacity: 1; visibility: visible; display: flex; overflow: visible; width: 229px; height: 85px; top: 0; aspect-ratio: auto; scale: 0.8 1.1; translate: 0 0; align-self: auto; flex-direction: column; rotate: 0; transform-origin: bottom;"/>
            <ui:Label text="Sail Rotation: 0°" name="sail-rotation-label" style="-unity-font-style: normal; font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/PirataOne-Regular.ttf?fileID=12800000&amp;guid=16f25ff010d8e574fbe3ec65d8403acb&amp;type=3#PirataOne-Regular&quot;); letter-spacing: 2px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255); width: 292px;"/>
            <ui:Image source="project://database/Assets/UI/plank.png?fileID=2800000&amp;guid=299978c49da158e47bfbec646c7e23aa&amp;type=3#plank" name="rotation-plank-mid" style="opacity: 1; visibility: visible; display: flex; overflow: visible; width: 229px; height: 85px; top: 0; aspect-ratio: auto; scale: 0.9 2; translate: 0 39px; align-self: auto; flex-direction: column; rotate: 0; transform-origin: center; flex-shrink: 1; position: absolute;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
